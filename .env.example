# ============================================================
# RentRadar environment template
#   1) cp .env.example .env.local
#   2) fill in the values marked REQUIRED
# ============================================================

# ---- PostgreSQL (runs in Docker; just pick a password) ----
POSTGRES_USER=rentradar
POSTGRES_PASSWORD=change_me_db_password        # REQUIRED
POSTGRES_DB=rentradar

# ---- Frontend (build-time; the browser calls this URL) ----
NEXT_PUBLIC_API_URL=http://localhost:4000

# ---- Backend ----
BACKEND_PORT=4000
# REQUIRED. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d
CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:4000

# Only used when running the backend OUTSIDE docker (docker-compose sets its own):
DATABASE_URL=postgres://rentradar:change_me_db_password@localhost:5432/rentradar

# ---- First admin account (created by `npm run seed:admin`) ----
ADMIN_EMAIL=admin@rentradar.local
ADMIN_PASSWORD=                                # REQUIRED, min 8 chars

# ---- ML service ----
ML_SERVICE_URL=http://localhost:8000
ML_TIMEOUT_MS=4000

# ---- Moderation / limits (defaults are sensible) ----
AUTO_APPROVE_BELOW_RISK=40      # fraud score below this => auto-approved
AUTO_APPROVE_WHEN_ML_DOWN=true  # keep site usable if the ML service is down
MAX_IMAGE_MB=5
MAX_IMAGES_PER_LISTING=8
MAX_LISTINGS_PER_DAY=10

# ---- Optional: none of the map/geocoding services need a key ----
# Maps use OpenStreetMap tiles (Leaflet); geocoding uses Nominatim. No signup needed.
